{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix app ci",
  "buildCommand": "npm run app:build",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://replace-with-your-service.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
