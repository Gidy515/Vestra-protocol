{
  "name": "vestra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:chain": "tsx --test --test-concurrency=1 tests/chain.test.ts",
    "test:model": "node --test tests/accounting.test.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "bash scripts/setup.sh",
    "build": "anchor build",
    "test:local": "bash scripts/test-local.sh",
    "meteora:validator": "tsx scripts/meteora/start-validator.ts",
    "meteora": "tsx scripts/meteora/cli.ts",
    "test:meteora": "tsx --test tests/meteora/offline.test.ts",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:service": "tsx scripts/frontend-server.ts",
    "test:frontend": "node --import tsx --test tests/frontend.test.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.1.2",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
